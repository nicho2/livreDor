{
  "name": "livredor",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "build:sites": "node scripts/build-sites.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:ui:fixture": "node scripts/ui-fixture.mjs",
    "test:watch": "node --watch --import ./tests/register.mjs --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "node --env-file=.env.local scripts/test-v1-integration.mjs",
    "test:sites": "node --env-file=.env.local scripts/test-v1-integration.mjs --sites",
    "test:sites:html": "node scripts/test-v1-integration.mjs --sites --html-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@supabase/supabase-js": "^2.117.1",
    "archiver": "^8.0.0",
    "next": "^16.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261001.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "miniflare": "5.20261001.0-alpha",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
