# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Total projects, including closed/archived. 0 pauses creation; default 3.
LIVREDOR_MAX_PROJECTS=3

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional demo shortcut
NEXT_PUBLIC_DEMO_PROJECT_SLUG=
## Emails OTP confirmés autorisés à créer des projets (configuration serveur).
## Liste séparée par des virgules ; vide = création désactivée.
LIVREDOR_SITE_MANAGERS=
